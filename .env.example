# Supabase Configuration
SUPABASE_PROJECT_ID="your_project_id"
SUPABASE_PUBLISHABLE_KEY="your_publishable_key"
SUPABASE_URL="https://your_project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_key"
VITE_SUPABASE_URL="https://your_project.supabase.co"

# Yoco Payment Gateway
# Get your keys from: https://portal.yoco.com/online/settings/api-keys
# Test Keys (for development)
VITE_YOCO_PUBLIC_KEY="pk_test_your_test_public_key"
YOCO_SECRET_KEY="sk_test_your_test_secret_key"

# Production Keys (replace before going live)
# VITE_YOCO_PUBLIC_KEY="pk_live_your_production_public_key"
# YOCO_SECRET_KEY="sk_live_your_production_secret_key"

# Application URL (for Yoco payment redirects)
VITE_APP_URL="http://localhost:8081"
